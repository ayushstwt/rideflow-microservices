# The Docker build context is the repository root (services share libs/common-events).
# Keep it small: only the Maven sources are needed to build the images.
.git
.github
.idea
.vscode
**/target
**/*.iml

# Documentation, scripts and local files are not needed to build or run the services.
docs
scripts
*.md
**/*.md

# Never send local secrets or local database files into the build context.
.env
.env.*
!.env.example
mysql-data
