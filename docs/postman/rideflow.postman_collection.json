        {
          "name": "6. Poll status until ACCEPTED",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{rideUrl}}/api/v1/rides/{{rideId}}/status",
              "host": [
                "{{rideUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rides",
                "{{rideId}}",
                "status"
              ]
            },
            "description": "Click \"Send\" again (or use the Collection Runner with this request repeated) until it reports ACCEPTED. In the runner the script below repeats the request itself, up to 30 times."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const attempts = Number(pm.collectionVariables.get(\"pollCount\") || 0) + 1;",
                  "if (body.status === \"ACCEPTED\") {",
                  "    pm.collectionVariables.set(\"pollCount\", 0);",
                  "    pm.collectionVariables.set(\"assignedDriverId\", body.driverId);",
                  "    pm.test(\"ACCEPTED with a driver\", () => pm.expect(body.driverId).to.be.a(\"string\"));",
                  "} else if (body.status === \"MATCHING\" && attempts < 30) {",
                  "    pm.collectionVariables.set(\"pollCount\", attempts);",
                  "    postman.setNextRequest(pm.info.requestName); // poll again",
                  "} else {",
                  "    pm.collectionVariables.set(\"pollCount\", 0);",
                  "    pm.test(\"ride reached ACCEPTED\", () => pm.expect(body.status).to.eql(\"ACCEPTED\"));",
                  "}"
                ]
              }
            }
          ]
