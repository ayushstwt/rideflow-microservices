    {
      "name": "Ride Service",
      "item": [
        {
          "name": "Request ride",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "description": "Same key + same riderId returns the same ride with 200 instead of creating a new one (201)."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{rideUrl}}/api/v1/rides/request",
              "host": [
                "{{rideUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rides",
                "request"
              ]
            },
            "description": "First call returns 201. Sending the same Idempotency-Key again returns 200 with the same ride. 409 ACTIVE_RIDE_EXISTS when the rider already has an active ride.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"riderId\": \"{{riderId}}\",\n  \"pickupLatitude\": 26.8467,\n  \"pickupLongitude\": 80.9462,\n  \"pickupAddress\": \"Hazratganj, Lucknow\",\n  \"dropLatitude\": 26.7606,\n  \"dropLongitude\": 80.8893,\n  \"dropAddress\": \"Chaudhary Charan Singh Airport, Lucknow\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh key for every new ride. The replay request below reuses {{idempotencyKey}} unchanged.",
                  "pm.collectionVariables.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created (first call)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"response has a ride id and is MATCHING\", function () {",
                  "    pm.expect(body.id).to.be.a(\"string\");",
                  "    pm.expect(body.status).to.eql(\"MATCHING\");",
                  "});",
                  "pm.collectionVariables.set(\"rideId\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Request ride (replay same Idempotency-Key, expect 200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "description": "Same key + same riderId returns the same ride with 200 instead of creating a new one (201)."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{rideUrl}}/api/v1/rides/request",
              "host": [
                "{{rideUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rides",
                "request"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"riderId\": \"{{riderId}}\",\n  \"pickupLatitude\": 26.8467,\n  \"pickupLongitude\": 80.9462,\n  \"pickupAddress\": \"Hazratganj, Lucknow\",\n  \"dropLatitude\": 26.7606,\n  \"dropLongitude\": 80.8893,\n  \"dropAddress\": \"Chaudhary Charan Singh Airport, Lucknow\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK (replay)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"same ride as before\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"rideId\")));"
                ]
              }
            }
          ]
        },
