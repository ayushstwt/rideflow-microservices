    {
      "name": "Happy path (run in order)",
      "description": "Same scenario as scripts/smoke-test.sh: register 3 drivers, request a ride, wait for ACCEPTED, check the driver is hidden from nearby, cancel, check the driver is back. Run the folder with the Collection Runner (needs the whole stack running).",
      "item": [
        {
          "name": "1. Register driver 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{locationUrl}}/api/v1/locations/drivers/update",
              "host": [
                "{{locationUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "locations",
                "drivers",
                "update"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"{{driver1Id}}\",\n  \"latitude\": 26.8477,\n  \"longitude\": 80.9472\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"driver1Id\", \"smoke-driver-\" + Date.now() + \"-1\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Register driver 2",
          "request": {
